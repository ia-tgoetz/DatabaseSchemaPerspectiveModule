                "onFileReceived": {
                  "config": {
                    "script": "\tisSVG\u003dFalse\n\tfrom java.util import Base64\n\tif isSVG:\n\t\tself.view.params.paletteItem.image\u003devent.file.getString()\n\telse:\n\t\t\n\t\tfile_bytes \u003d event.file.getBytes()\n\t\tfile_name \u003d event.file.name\n\t\t\n\t\t# 2. Extract the file extension (e.g., \u0027my_image.png\u0027 -\u003e \u0027png\u0027)\n\t\text \u003d file_name.split(\u0027.\u0027)[-1].lower()\n\t\t\n\t\t# 3. Determine the correct MIME type based on the extension\n\t\tif ext in [\u0027jpg\u0027, \u0027jpeg\u0027]:\n\t\t    mime_type \u003d \u0027image/jpeg\u0027\n\t\telif ext \u003d\u003d \u0027svg\u0027:\n\t\t    mime_type \u003d \u0027image/svg+xml\u0027\n\t\telse:\n\t\t    # Defaults to things like \u0027image/png\u0027, \u0027image/gif\u0027, etc.\n\t\t    mime_type \u003d \u0027image/\u0027 + ext \n\t\t    \n\t\t# 4. Encode the Java byte array to a Base64 string\n\t\tb64_string \u003d Base64.getEncoder().encodeToString(file_bytes)\n\t\t\n\t\t# 5. Construct the final Data URI string\n\t\tdata_uri \u003d \"data:{};base64,{}\".format(mime_type, b64_string)\n\t\n\t\tself.view.params.paletteItem.image\u003ddata_uri\n"
                  },
                  "scope": "G",
                  "type": "script"
                },
                "onUploadsCleared": {
                  "config": {
                    "script": "\tself.view.params.paletteItem.image\u003d\"\"\n"
                  },
                  "scope": "G",
